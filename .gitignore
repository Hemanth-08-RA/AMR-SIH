# ROS 2 build / install / log directories
build/
install/
log/
**/build/
**/install/
**/log/

# Python byte-compiled / cache / egg files
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/

# Editor / OS temporary files
*.swp
*.swo
*~
.DS_Store
*.bak
*.backup

# Colcon ignore files
.COLCON_IGNORE
**/COLCON_IGNORE
